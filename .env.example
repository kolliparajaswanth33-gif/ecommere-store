# Do not put your real password in this file or upload it to GitHub.
# Create these as Windows environment variables instead.
KIRANA_GMAIL_ADDRESS=your-gmail-address@gmail.com
KIRANA_GMAIL_APP_PASSWORD=your-16-character-gmail-app-password
DJANGO_SECRET_KEY=generate-a-long-random-secret-key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=your-service.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-service.onrender.com
